# ============================================================
#  Good Family — переменные окружения
#  Скопируйте в .env и заполните реальными значениями.
#  НЕ КОММИТЬТЕ .env — он в .gitignore.
# ============================================================

# --- База данных (PostgreSQL) ---
# Формат: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://familyfocus_user:CHANGE_ME@127.0.0.1:5432/familyfocus

# --- Секрет для экспорта статистики (/export_stats) ---
# Сгенерировать: openssl rand -base64 24
EXPORT_STATS_SECRET=CHANGE_ME

# --- SMTP (Яндекс, домен .com) ---
# Пароль — «пароль приложения», не пароль от аккаунта.
# Яндекс: Настройки → Безопасность → Пароли приложений.
SMTP_USER=goodfamilyapp@yandex.com
SMTP_PASSWORD=CHANGE_ME
SMTP_HOST=smtp.yandex.com
SMTP_PORT=465
