<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP разрешён только нашему серверу (домена нет, работаем по IP) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">89.108.66.36</domain>
    </domain-config>

    <!-- Всё остальное — только HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
